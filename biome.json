{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "linter": {
    "rules": {
      "a11y": {
        "noStaticElementInteractions": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "all",
      "bracketSameLine": false,
      "attributePosition": "multiline"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
